# Google Cloud / Agent Platform (Enterprise) — required for Vertex + Agent Runtime
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Model endpoint for gemini-3.x (inference). Agent Engine --region can differ.
GOOGLE_CLOUD_LOCATION=global

# Optional: Google AI Studio API key (unset Enterprise vars above)
# GEMINI_API_KEY=your-gemini-api-key

# Agent mode: planning (default) | production (mock video/C2PA stubs)
# CREATIVE_DIRECTOR_MODE=planning
# CREATIVE_DIRECTOR_MODE=production

# OpenTelemetry / Agent Runtime telemetry (local dev parity with deployed agent)
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY

# Agent Runtime deploy (agents-cli deploy)
# GOOGLE_CLOUD_REGION=us-east1
