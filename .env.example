# Google Cloud / Agent Platform (Enterprise) — required for Vertex + Agent Runtime
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Model endpoint for gemini-3.x (inference). Agent Engine --region can differ.
GOOGLE_CLOUD_LOCATION=global

# Optional: Google AI Studio API key (unset Enterprise vars above)
# GEMINI_API_KEY=your-gemini-api-key

# Agent mode: planning (default) | production (mock video/C2PA stubs)
# CREATIVE_DIRECTOR_MODE=planning
# CREATIVE_DIRECTOR_MODE=production

# OpenTelemetry / Agent Runtime telemetry (local dev parity with deployed agent)
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY

# Agent Runtime deploy (agents-cli deploy)
# GOOGLE_CLOUD_REGION=us-east1
# CREATIVE_DIRECTOR_MODE=production
# RENDERS_GCS_BUCKET=creative-ai-491118-creative-pixels-renders
# VERTEX_LOCATION=us-central1
# C2PA provenance (Phase 3A/3B): unsigned metadata in GCS; handoff to Pixels UI
# C2PA_PROVENANCE_MODE=handoff   # default — pending_user_sign + sidecar URLs
# C2PA_PROVENANCE_MODE=unsigned  # 3A only — c2pa_status unsigned

# Grafana Cloud MCP — accept Assistant terms on the stack first
# Local / playground (hosted MCP + browser OAuth on first connect):
GRAFANA_URL=https://thecreative.grafana.net
# Agent Runtime (unattended): self-hosted open-source Grafana MCP + service account
# Do NOT use GRAFANA_URL alone on Runtime — hosted MCP has no machine token.
# GRAFANA_MCP_URL=http://127.0.0.1:8000/mcp
# GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_token
# GRAFANA_CLOUD_MCP_URL=https://mcp.grafana.com/mcp
# Grafana Agent Observability (generation ingest + OTLP Performance metrics)
# Get the glc_ token from:
#   https://thecreative.grafana.net/plugins/grafana-agento11y-app → Connection
#   scopes: sigil:write, metrics:write, traces:write, logs:write
# Then: printf '%s' 'glc_...' | ./scripts/set-agento11y-token.sh
AGENTO11Y_ENDPOINT=https://agento11y-prod-us-east-0.grafana.net
AGENTO11Y_PROTOCOL=http
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_AUTH_TENANT_ID=829818
# AGENTO11Y_AUTH_TOKEN=glc_...   # set via scripts/set-agento11y-token.sh
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-2.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic ...  # built by set-agento11y-token.sh
