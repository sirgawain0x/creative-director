{
  "name": "creative-director-ai",
  "version": "1.0.0",
  "type": "module",
  "description": "Autonomous AI Music Video Director built on Google ADK TypeScript",
  "main": "agent.ts",
  "engines": {
    "node": ">=24.13.0",
    "npm": ">=11.8.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit",
    "adk:run": "node scripts/run-adk.mjs run agent.ts",
    "adk:web": "node scripts/run-adk.mjs web agent.ts",
    "adk:api": "node scripts/run-adk.mjs api_server agent.ts --port 8765 --host 127.0.0.1",
    "adk:proxy": "node scripts/adk-camel-proxy.mjs",
    "grafana:verify": "node scripts/verify-grafana-mcp.mjs",
    "deploy": "bash scripts/deploy.sh",
    "eval": "agents-cli eval run --dataset tests/eval/datasets/basic-dataset.json --config tests/eval/eval_config.yaml --url http://127.0.0.1:8766 --app-name agent --concurrency 1"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.17.0",
    "@google/adk": "^2.0.0",
    "@google/adk-devtools": "^2.0.0",
    "@grafana/agento11y": "^0.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resource-detector-gcp": "^0.40.3",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
