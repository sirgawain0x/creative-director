{
  "name": "creative-director-ai",
  "version": "1.0.0",
  "type": "module",
  "description": "Autonomous AI Music Video Director built on Google ADK TypeScript",
  "main": "agent.ts",
  "engines": {
    "node": ">=24.13.0",
    "npm": ">=11.8.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit",
    "adk:run": "adk run agent.ts --otel_to_cloud",
    "adk:web": "adk web agent.ts --otel_to_cloud",
    "adk:api": "adk api_server agent.ts --port 8765 --host 127.0.0.1 --otel_to_cloud",
    "adk:proxy": "node scripts/adk-camel-proxy.mjs",
    "grafana:verify": "node scripts/verify-grafana-mcp.mjs",
    "deploy": "agents-cli deploy --project creative-ai-491118 --region us-east1 --update-env-vars CREATIVE_DIRECTOR_MODE=production,RENDERS_GCS_BUCKET=creative-ai-491118-creative-pixels-renders,VERTEX_LOCATION=us-central1,PIXELS_HEADLESS_URL=https://pixels-headless-3ortoh2aiq-uc.a.run.app",
    "eval": "agents-cli eval run --dataset tests/eval/datasets/basic-dataset.json --config tests/eval/eval_config.yaml --url http://127.0.0.1:8766 --app-name agent --concurrency 1"
  },
  "dependencies": {
    "@google-cloud/opentelemetry-cloud-monitoring-exporter": "^0.21.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@google-cloud/storage": "^7.17.0",
    "@google/adk": "^2.0.0",
    "@google/adk-devtools": "^2.0.0",
    "@grafana/agento11y": "^0.13.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
